<?xml version="1.0"?>
<!-- 5 m walled arena with five boxes for Gazebo Harmonic (same layout as the ROS1 arena and
     close to the toy sim). Ground and light are inline: no Fuel downloads. Walls and boxes are
     slippery (mu 0.05) so the LIMO's grippy tyres cannot climb them and flip the robot.
     Physics: 1 ms steps, Gazebo Harmonic's default.
     Generated by hand from the ROS1 world; edit both if the layout changes. -->
<sdf version="1.9">
  <world name="cadence_arena">
    <physics name="1ms" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <model name="arena">
      <static>true</static>
      <link name="north"><pose>0 2.55 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>5.2 0.1 0.3</size></box></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>5.2 0.1 0.3</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual></link>
      <link name="south"><pose>0 -2.55 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>5.2 0.1 0.3</size></box></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>5.2 0.1 0.3</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual></link>
      <link name="east"><pose>2.55 0 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 5.0 0.3</size></box></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.1 5.0 0.3</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual></link>
      <link name="west"><pose>-2.55 0 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 5.0 0.3</size></box></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.1 5.0 0.3</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual></link>
      <link name="box1"><pose>1.3 0.9 0.15 0 0 0.3</pose>
        <collision name="c"><geometry><box><size>0.5 0.4 0.3</size></box></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.5 0.4 0.3</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual></link>
      <link name="box2"><pose>-1.2 1.4 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.6 0.3 0.3</size></box></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.6 0.3 0.3</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual></link>
      <link name="box3"><pose>-1.5 -1.0 0.15 0 0 0.6</pose>
        <collision name="c"><geometry><box><size>0.4 0.4 0.3</size></box></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.3</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual></link>
      <link name="box4"><pose>0.8 -1.5 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.7 0.3 0.3</size></box></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.7 0.3 0.3</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual></link>
      <link name="box5"><pose>0 1.0 0.15 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.3 0.3 0.3</size></box></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.3 0.3 0.3</size></box></geometry><material><diffuse>0.6 0.6 0.65 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>
